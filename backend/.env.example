# ---------------------------------------------------------------
# GZ AFL - mẫu biến môi trường
# Sao chép file này thành backend/.env rồi điền giá trị thật.
#   Copy-Item backend\.env.example backend\.env
# File backend/.env đã được .gitignore bỏ qua, KHÔNG commit lên git.
# ---------------------------------------------------------------

# Cổng lắng nghe của server (mặc định 3000)
PORT=3000

# development | production
NODE_ENV=development

# ---------------------------------------------------------------
# BẮT BUỘC khi NODE_ENV=production (>= 32 ký tự).
# Tạo khoá mới:  npm run gen-secret
# Ghi thẳng vào .env:  npm run gen-secret -- --write
# Đổi khoá này sẽ làm toàn bộ phiên đăng nhập hiện tại hết hiệu lực.
# ---------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------
# HTTPS (chạy trực tiếp bằng Node, không qua Nginx/Caddy)
# Điền đường dẫn tới chứng chỉ để server tự chạy HTTPS.
# Bỏ trống nếu bạn dùng reverse proxy có sẵn TLS.
# ---------------------------------------------------------------
# SSL_KEY_PATH=C:\certs\gzafl.key
# SSL_CERT_PATH=C:\certs\gzafl.crt

# Chạy sau reverse proxy (Nginx, Caddy, Cloudflare...) thì BẮT BUỘC bật,
# để req.protocol = https và cookie secure hoạt động đúng.
# Nhận: true | false | số hop (ví dụ 1) | danh sách IP/subnet
# TRUST_PROXY=1

# Ghi đè việc cookie phiên chỉ gửi qua HTTPS. Thường để trống
# (tự động BẬT khi NODE_ENV=production).
# COOKIE_SECURE=true

# ---------------------------------------------------------------
# HẠ TẦNG / VẬN HÀNH
# ---------------------------------------------------------------
# Nơi lưu bộ đếm chống spam / dò mật khẩu:
#   memory  nhanh, nhưng MỖI TIẾN TRÌNH một bộ đếm -> chỉ đúng khi chạy 1 tiến trình
#   sqlite  dùng chung nhiều tiến trình/instance trên cùng file DB (khuyến nghị production)
RATE_LIMIT_STORE=sqlite

# (Tuỳ chọn) đổi vị trí dữ liệu. Đường dẫn tương đối tính từ thư mục backend/.
# DB_PATH=data/gzafl.sqlite
# UPLOAD_DIR=uploads
# BACKUP_DIR=backups
# Số ngày giữ bản sao lưu cũ (dùng cho: npm run backup)
# BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------
# GỬI EMAIL — dùng cho mã xác thực OTP (3 việc: xác thực email khi
# đăng ký, để khách tự đặt lại mật khẩu khi quên, và xác thực khi
# đăng nhập).
#
#   EMAIL_OTP=auto  BẬT khi đã điền SMTP_HOST và MAIL_FROM (khuyến nghị).
#                   Ở môi trường development mà chưa có SMTP thì vẫn bật,
#                   nhưng thư chỉ được IN RA CONSOLE (mã cũng trả về trong
#                   API) để bạn test được ngay.
#   EMAIL_OTP=on    Luôn bật. CẢNH BÁO: chưa có SMTP thì không ai đăng ký được.
#   EMAIL_OTP=off   Luôn tắt (đăng ký vẫn bắt buộc nhập email, nhưng không xác thực).
#
# Riêng bước xác thực KHI ĐĂNG NHẬP có công tắc riêng:
#   LOGIN_OTP=auto  Bật khi xác thực email đang bật VÀ gửi được thư (khuyến nghị).
#                   Chưa có SMTP thì đăng nhập vẫn chỉ cần mật khẩu, tránh khoá
#                   toàn bộ người dùng ra ngoài.
#   LOGIN_OTP=on    Luôn bắt buộc mã. CẢNH BÁO: chưa có SMTP thì KHÔNG AI ĐĂNG NHẬP ĐƯỢC.
#   LOGIN_OTP=off   Đăng nhập chỉ cần mật khẩu. Dùng khi máy chủ thư gặp sự cố.
#
# LƯU Ý: mỗi lần đăng nhập tốn 1 email. Gmail cá nhân chỉ cho ~500 thư/ngày.
#
# Chưa điền gì thì hệ thống chạy bình thường, chỉ là bước xác thực tắt đi.
# ---------------------------------------------------------------
# EMAIL_OTP=auto
# LOGIN_OTP=auto

# --- Ví dụ 1: Gmail (dễ nhất, khoảng 500 thư/ngày) ---
# Bật xác thực 2 lớp cho Gmail -> tạo "Mật khẩu ứng dụng" 16 ký tự -> điền vào SMTP_PASS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ten-ban@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM=ten-ban@gmail.com
# MAIL_FROM_NAME=GZ AFL

# --- Ví dụ 2: Brevo (miễn phí 300 thư/ngày, tỉ lệ vào Inbox tốt hơn) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=login-dang-nhap-brevo
# SMTP_PASS=ma-smtp-brevo
# MAIL_FROM=no-reply@gzafl.vn
# MAIL_FROM_NAME=GZ AFL

# ---------------------------------------------------------------
# Nghiệp vụ
# ---------------------------------------------------------------
# Số dư tối thiểu được rút (đồng)
WITHDRAWAL_MIN=1000

# Điểm thưởng + tiền cho mỗi người được giới thiệu
# REFERRAL_POINTS=10000
# REFERRAL_BONUS=10000

# ---------------------------------------------------------------
# Nhà cung cấp affiliate: mock | accesstrade | shopee
# mock = chạy được ngay, không cần tài khoản (hoa hồng do admin nhập tay)
# ---------------------------------------------------------------
AFFILIATE_PROVIDER=mock

# Tiền tố sub_id gửi sang nhà cung cấp (mặc định gzafl) -> ví dụ: gzafl-u1
# AFFILIATE_SUB_ID_PREFIX=gzafl

# Tỷ lệ hoàn tiền cho người dùng so với hoa hồng mạng trả về.
# 1 = hoàn hết, 0.7 = hoàn 70% (giữ lại 30%). Mặc định 1.
# CASHBACK_RATE=1

# --- AccessTrade ---
# ACCESSTRADE_API_KEY=
# ACCESSTRADE_CAMPAIGN_ID=
# ACCESSTRADE_SHORT_DOMAIN=

# --- Shopee Affiliate (Open API) ---
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=

# ---------------------------------------------------------------
# ĐỐI SOÁT POSTBACK (mạng affiliate báo hoa hồng về)
#
# Cách dùng với AccessTrade:
#   1. Đặt POSTBACK_SECRET thành một chuỗi ngẫu nhiên, khó đoán. Tạo nhanh:
#        node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   2. Vào Account Settings -> Properties -> Postback, khai URL:
#        https://ten-mien-cua-ban/api/postback/accesstrade
#   3. Thêm tham số có giá trị CỐ ĐỊNH bằng đúng POSTBACK_SECRET
#      (AccessTrade gọi là "Action ID"):  ví dụ tên tham số là secret
#   4. Thêm các tham số dữ liệu: Transaction ID, Product ID, Reward,
#      Conversion Status, và các sub id.
#
# Nếu tên tham số mạng gửi KHÁC mặc định, ép lại bằng các biến sau:
#   POSTBACK_PARAM_SECRET / POSTBACK_PARAM_TRANSACTION / POSTBACK_PARAM_PRODUCT
#   POSTBACK_PARAM_CONVERSION / POSTBACK_PARAM_REWARD / POSTBACK_PARAM_STATUS
#   POSTBACK_PARAM_SUB
#
# Mọi lần gọi đều được lưu vào bảng postback_logs (kể cả khi sai chìa khoá)
# và xem được ở trang quản trị -> tab "Đối soát".
# KHÔNG đặt POSTBACK_SECRET = rỗng, khi đó mọi postback sẽ bị từ chối.
# ---------------------------------------------------------------
# POSTBACK_SECRET=

# ---------------------------------------------------------------
# Thông tin hỗ trợ hiển thị trên trang web (nếu bỏ trống sẽ dùng
# giá trị mặc định ghi trong components/guide.html)
# ---------------------------------------------------------------
# SUPPORT_EMAIL=
# SUPPORT_ZALO=

# ---------------------------------------------------------------
# Trợ lý hỗ trợ (chatbot) ở góc phải-dưới
#
# Bỏ trống AI_API_KEY  -> trợ lý trả lời theo kịch bản có sẵn trong
#                         backend/lib/supportKnowledge.js (miễn phí, không cần mạng).
# Điền AI_API_KEY      -> trợ lý trả lời bằng AI qua API chuẩn OpenAI.
#                         Chỉ cần AI_API_KEY, hệ thống tự đoán nhà cung cấp theo
#                         tiền tố khoá; muốn chắc chắn thì điền thêm AI_BASE_URL + AI_MODEL.
#
#   Google Gemini (có gói miễn phí — lấy khoá tại https://aistudio.google.com/apikey)
#     Khoá Google có 2 dạng: "AIza..." và "AQ...." - cả hai đều dùng được.
#     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     AI_MODEL=gemini-flash-latest
#
#   Groq (miễn phí — https://console.groq.com/keys)
#     AI_BASE_URL=https://api.groq.com/openai/v1
#     AI_MODEL=llama-3.3-70b-versatile
#
#   OpenRouter (có model miễn phí — https://openrouter.ai/keys)
#     AI_BASE_URL=https://openrouter.ai/api/v1
#     AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
#   OpenAI (trả phí)
#     AI_BASE_URL=https://api.openai.com/v1
#     AI_MODEL=gpt-4o-mini
#
# AI_ENABLED=off để tạm tắt AI (vẫn giữ khoá) mà không phải xoá cấu hình.
# LƯU Ý: khoá API chỉ nằm ở server này, KHÔNG bao giờ gửi xuống trình duyệt.
# ---------------------------------------------------------------
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=
# AI_ENABLED=true
# AI_TIMEOUT_MS=25000
# AI_MAX_TOKENS=600
# AI_TEMPERATURE=0.4
# Trần TỔNG số lượt gọi AI mỗi ngày (mọi IP cộng lại). Vượt trần thì trợ lý
# vẫn trả lời nhưng bằng kịch bản có sẵn. Đặt 0 = không giới hạn.
# AI_DAILY_LIMIT=800
