# ---------------------------------------------------------------
# GZ AFL - mẫu biến môi trường
# Sao chép file này thành backend/.env rồi điền giá trị thật.
#   Copy-Item backend\.env.example backend\.env
# File backend/.env đã được .gitignore bỏ qua, KHÔNG commit lên git.
# ---------------------------------------------------------------

# Cổng lắng nghe của server (mặc định 3000)
PORT=3000

# development | production
NODE_ENV=development

# ---------------------------------------------------------------
# BẮT BUỘC khi NODE_ENV=production (>= 32 ký tự).
# Tạo khoá mới:  npm run gen-secret
# Ghi thẳng vào .env:  npm run gen-secret -- --write
# Đổi khoá này sẽ làm toàn bộ phiên đăng nhập hiện tại hết hiệu lực.
# ---------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------
# HTTPS (chạy trực tiếp bằng Node, không qua Nginx/Caddy)
# Điền đường dẫn tới chứng chỉ để server tự chạy HTTPS.
# Bỏ trống nếu bạn dùng reverse proxy có sẵn TLS.
# ---------------------------------------------------------------
# SSL_KEY_PATH=C:\certs\gzafl.key
# SSL_CERT_PATH=C:\certs\gzafl.crt

# Chạy sau reverse proxy (Nginx, Caddy, Cloudflare...) thì BẮT BUỘC bật,
# để req.protocol = https và cookie secure hoạt động đúng.
# Nhận: true | false | số hop (ví dụ 1) | danh sách IP/subnet
# TRUST_PROXY=1

# Ghi đè việc cookie phiên chỉ gửi qua HTTPS. Thường để trống
# (tự động BẬT khi NODE_ENV=production).
# COOKIE_SECURE=true

# ---------------------------------------------------------------
# GỬI EMAIL — dùng cho mã xác thực OTP (3 việc: xác thực email khi
# đăng ký, để khách tự đặt lại mật khẩu khi quên, và xác thực khi
# đăng nhập).
#
#   EMAIL_OTP=auto  BẬT khi đã điền SMTP_HOST và MAIL_FROM (khuyến nghị).
#                   Ở môi trường development mà chưa có SMTP thì vẫn bật,
#                   nhưng thư chỉ được IN RA CONSOLE (mã cũng trả về trong
#                   API) để bạn test được ngay.
#   EMAIL_OTP=on    Luôn bật. CẢNH BÁO: chưa có SMTP thì không ai đăng ký được.
#   EMAIL_OTP=off   Luôn tắt (đăng ký vẫn bắt buộc nhập email, nhưng không xác thực).
#
# Riêng bước xác thực KHI ĐĂNG NHẬP có công tắc riêng:
#   LOGIN_OTP=auto  Bật khi xác thực email đang bật VÀ gửi được thư (khuyến nghị).
#                   Chưa có SMTP thì đăng nhập vẫn chỉ cần mật khẩu, tránh khoá
#                   toàn bộ người dùng ra ngoài.
#   LOGIN_OTP=on    Luôn bắt buộc mã. CẢNH BÁO: chưa có SMTP thì KHÔNG AI ĐĂNG NHẬP ĐƯỢC.
#   LOGIN_OTP=off   Đăng nhập chỉ cần mật khẩu. Dùng khi máy chủ thư gặp sự cố.
#
# LƯU Ý: mỗi lần đăng nhập tốn 1 email. Gmail cá nhân chỉ cho ~500 thư/ngày.
#
# Chưa điền gì thì hệ thống chạy bình thường, chỉ là bước xác thực tắt đi.
# ---------------------------------------------------------------
# EMAIL_OTP=auto
# LOGIN_OTP=auto

# --- Ví dụ 1: Gmail (dễ nhất, khoảng 500 thư/ngày) ---
# Bật xác thực 2 lớp cho Gmail -> tạo "Mật khẩu ứng dụng" 16 ký tự -> điền vào SMTP_PASS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ten-ban@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
# MAIL_FROM=ten-ban@gmail.com
# MAIL_FROM_NAME=GZ AFL

# --- Ví dụ 2: Brevo (miễn phí 300 thư/ngày, tỉ lệ vào Inbox tốt hơn) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=login-dang-nhap-brevo
# SMTP_PASS=ma-smtp-brevo
# MAIL_FROM=no-reply@gzafl.vn
# MAIL_FROM_NAME=GZ AFL

# ---------------------------------------------------------------
# Nghiệp vụ
# ---------------------------------------------------------------
# Số dư tối thiểu được rút (đồng)
WITHDRAWAL_MIN=50000

# Điểm thưởng + tiền cho mỗi người được giới thiệu
# REFERRAL_POINTS=10000
# REFERRAL_BONUS=10000

# ---------------------------------------------------------------
# Nhà cung cấp affiliate: mock | accesstrade | shopee
# mock = chạy được ngay, không cần tài khoản (hoa hồng do admin nhập tay)
# ---------------------------------------------------------------
AFFILIATE_PROVIDER=mock

# Tiền tố sub_id gửi sang nhà cung cấp (mặc định gzafl) -> ví dụ: gzafl-u1
# AFFILIATE_SUB_ID_PREFIX=gzafl

# --- AccessTrade ---
# ACCESSTRADE_API_KEY=
# ACCESSTRADE_CAMPAIGN_ID=

# --- Shopee Affiliate (Open API) ---
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=

# ---------------------------------------------------------------
# Thông tin hỗ trợ hiển thị trên trang web (nếu bỏ trống sẽ dùng
# giá trị mặc định ghi trong components/guide.html)
# ---------------------------------------------------------------
# SUPPORT_EMAIL=
# SUPPORT_ZALO=
