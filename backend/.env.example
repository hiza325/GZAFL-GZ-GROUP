# ---------------------------------------------------------------
# GZ AFL - mẫu biến môi trường
# Sao chép file này thành backend/.env rồi điền giá trị thật.
#   Copy-Item backend\.env.example backend\.env
# File backend/.env đã được .gitignore bỏ qua, KHÔNG commit lên git.
# ---------------------------------------------------------------

# Cổng lắng nghe của server (mặc định 3000)
PORT=3000

# development | production
NODE_ENV=development

# ---------------------------------------------------------------
# BẮT BUỘC khi NODE_ENV=production (>= 32 ký tự).
# Tạo khoá mới:  npm run gen-secret
# Ghi thẳng vào .env:  npm run gen-secret -- --write
# Đổi khoá này sẽ làm toàn bộ phiên đăng nhập hiện tại hết hiệu lực.
# ---------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------
# HTTPS (chạy trực tiếp bằng Node, không qua Nginx/Caddy)
# Điền đường dẫn tới chứng chỉ để server tự chạy HTTPS.
# Bỏ trống nếu bạn dùng reverse proxy có sẵn TLS.
# ---------------------------------------------------------------
# SSL_KEY_PATH=C:\certs\gzafl.key
# SSL_CERT_PATH=C:\certs\gzafl.crt

# Chạy sau reverse proxy (Nginx, Caddy, Cloudflare...) thì BẮT BUỘC bật,
# để req.protocol = https và cookie secure hoạt động đúng.
# Nhận: true | false | số hop (ví dụ 1) | danh sách IP/subnet
# TRUST_PROXY=1

# Ghi đè việc cookie phiên chỉ gửi qua HTTPS. Thường để trống
# (tự động BẬT khi NODE_ENV=production).
# COOKIE_SECURE=true

# ---------------------------------------------------------------
# Nghiệp vụ
# ---------------------------------------------------------------
# Số dư tối thiểu được rút (đồng)
WITHDRAWAL_MIN=50000

# Điểm thưởng + tiền cho mỗi người được giới thiệu
# REFERRAL_POINTS=10000
# REFERRAL_BONUS=10000

# ---------------------------------------------------------------
# Nhà cung cấp affiliate: mock | accesstrade | shopee
# mock = chạy được ngay, không cần tài khoản (hoa hồng do admin nhập tay)
# ---------------------------------------------------------------
AFFILIATE_PROVIDER=mock

# Tiền tố sub_id gửi sang nhà cung cấp (mặc định gzafl) -> ví dụ: gzafl-u1
# AFFILIATE_SUB_ID_PREFIX=gzafl

# --- AccessTrade ---
# ACCESSTRADE_API_KEY=
# ACCESSTRADE_CAMPAIGN_ID=

# --- Shopee Affiliate (Open API) ---
# SHOPEE_AFFILIATE_APP_ID=
# SHOPEE_AFFILIATE_SECRET=

# ---------------------------------------------------------------
# Thông tin hỗ trợ hiển thị trên trang web (nếu bỏ trống sẽ dùng
# giá trị mặc định ghi trong components/guide.html)
# ---------------------------------------------------------------
# SUPPORT_EMAIL=
# SUPPORT_ZALO=
