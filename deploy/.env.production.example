# ---------------------------------------------------------------
# GZ AFL - cấu hình PRODUCTION (mẫu)
#
# Sao chép thành backend/.env rồi điền:
#     cp deploy/.env.production.example backend/.env
#     cd backend && npm run gen-secret -- --write   # ghi JWT_SECRET
#
# KHÔNG commit backend/.env lên git.
# Kiểm tra lại bằng: cd backend && npm run check:deploy
# ---------------------------------------------------------------

# --- Bắt buộc ---------------------------------------------------
PORT=3000
NODE_ENV=production

# Sinh bằng: npm run gen-secret -- --write
JWT_SECRET=

# Đổi thành tên miền thật. BẮT BUỘC ở production.
# Thiếu biến này server sẽ không khởi động.
PUBLIC_BASE_URL=https://gzafl.vn

# Bật khi chạy sau Nginx/Caddy/Cloudflare (bắt buộc để cookie secure hoạt động).
TRUST_PROXY=1

# Nhiều tiến trình trên cùng máy thì dùng sqlite để chung bộ đếm chống spam.
RATE_LIMIT_STORE=sqlite

# --- Gửi email (BẮT BUỘC ở production) -------------------------
# Thiếu SMTP hợp lệ thì server TỪ CHỐI KHỞI ĐỘNG (trừ khi đặt
# ALLOW_UNVERIFIED_EMAIL=1).
EMAIL_OTP=auto
LOGIN_OTP=auto

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ten-ban@gmail.com
# Gmail: phải là "Mật khẩu ứng dụng" 16 ký tự, không phải mật khẩu đăng nhập.
SMTP_PASS=
MAIL_FROM=no-reply@gzafl.vn
MAIL_FROM_NAME=GZ AFL

# Chỉ dùng khi thật sự chưa có SMTP và đã chấp nhận rủi ro:
# ALLOW_UNVERIFIED_EMAIL=1

# --- Nghiệp vụ --------------------------------------------------
WITHDRAWAL_MIN=1000
CASHBACK_RATE=1
AFFILIATE_PROVIDER=mock

# --- Nhận hoa hồng từ mạng affiliate ---------------------------
# Tạo khoá ngẫu nhiên:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTBACK_SECRET=

# Chỉ bật API thật cho sàn đã được duyệt campaign, ví dụ:
# AFFILIATE_LIVE_PLATFORMS=TikTok Shop
# ACCESSTRADE_API_KEY=
# ACCESSTRADE_CAMPAIGN_SHOPEE=
# ACCESSTRADE_CAMPAIGN_TIKTOK=
# ACCESSTRADE_CAMPAIGN_TIKI=
# ACCESSTRADE_CAMPAIGN_LAZADA=

# --- Liên hệ hiển thị trên web ---------------------------------
SUPPORT_EMAIL=
SUPPORT_ZALO=

# --- Trợ lý hỗ trợ (tuỳ chọn) ----------------------------------
# Bỏ trống -> trả lời theo kịch bản, không cần Internet.
# AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash-lite
# AI_ENABLED=true
# AI_DAILY_LIMIT=800

# --- Vị trí dữ liệu (mặc định là đủ) ---------------------------
# DB_PATH=data/gzafl.sqlite
# UPLOAD_DIR=uploads
# BACKUP_DIR=backups
# BACKUP_KEEP_DAYS=14
